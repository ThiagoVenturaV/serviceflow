# Copie este arquivo para .env e preencha com suas credenciais reais
# NÃO commite o .env no GitHub!

# ── Credenciais Groq (IA) ─────────────────────────────────────────
# Sem prefixo VITE_ para não expor ao bundle do cliente
GROQ_API_KEY=gsk_SUA_CHAVE_AQUI

# ── Credenciais ServiceNow ───────────────────────────────────────
# Sem prefixo VITE_ para não expor ao bundle do cliente
SERVICENOW_INSTANCE=https://SUA_INSTANCIA.service-now.com
SERVICENOW_USER=admin
SERVICENOW_PASSWORD=SUA_SENHA_AQUI

# ── Compatibilidade legada (mantidos temporariamente) ───────────
# Remova após confirmar que o Vercel está usando as variáveis acima
# VITE_GROQ_API_KEY=...
# VITE_SERVICENOW_INSTANCE=...
# VITE_SERVICENOW_USER=...
# VITE_SERVICENOW_PASSWORD=...
